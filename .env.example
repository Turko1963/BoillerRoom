# Copy to .env (or set these in your process manager / Docker) and adjust.
PORT=3000
HOST=0.0.0.0
# SQLite file for rounds and paper orders. The folder is created if missing.
DB_PATH=data/boilerroom.db
# live = real stocks (Yahoo Finance + SEC EDGAR) and crypto (Binance). demo = fictional companies, offline.
MARKET_PROVIDER=live
# SEC asks every client to identify itself with a contact email. Put yours here.
SEC_USER_AGENT=BoilerRoom your-name@your-domain.com
# Paper book size in dollars, used by the Dealer to estimate slippage.
BOOK_SIZE=10000000
