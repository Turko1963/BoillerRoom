# Copy to .env (or set these in your process manager / Docker) and adjust.
PORT=3000
HOST=0.0.0.0
# SQLite file for rounds and paper orders. The folder is created if missing.
DB_PATH=data/boilerroom.db
# live = real stocks (Yahoo Finance + SEC EDGAR) and crypto (Binance). demo = fictional companies, offline.
MARKET_PROVIDER=live
# SEC asks every client to identify itself with a contact email. Put yours here.
SEC_USER_AGENT=BoilerRoom your-name@your-domain.com
# Paper book size in dollars, used by the Dealer to estimate slippage.
BOOK_SIZE=10000000

# AI brains (optional). Add a key and its button turns on in the header switch.
# Claude: https://console.anthropic.com  -  Gemini: https://aistudio.google.com
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Models. Claude defaults to claude-opus-5-5. Gemini picks the newest stable flash model your key can use.
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=

# Protects the whole site with a password (the browser asks for it; any user name works).
# Strongly recommended on a public server: AI rounds spend your API credit.
ACCESS_PASSWORD=

# BackStage Capital members code: six digits, checked on the server. Required: without it the room stays locked.
# Share it only with members. Never put it in the repository or the HTML.
ACCESS_CODE=

# Bull vs Bear add-on (fight strip in the room, fight in the intro): on or off. Default on.
# Also switchable without a restart: data/features.json with {"bullbear": false}
BULLBEAR=on

# Optional: a free CoinGecko "demo" API key raises the rate limit for the crypto desks.
# COINGECKO_API_KEY=

# Optional: an api.ftc.gov key for the FTC merger notices (the public DEMO_KEY is used otherwise).
# FTC_API_KEY=
