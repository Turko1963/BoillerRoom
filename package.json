{
  "name": "boiler-room",
  "version": "0.1.0",
  "private": true,
  "description": "Boiler Room: seven AI desks research, debate and vote on a trade. Frontend plus API server.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "check:sources": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check-sources.mjs",
    "backtest:management": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backtest-management.mjs",
    "members": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/members.mjs",
    "predictions": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/predictions.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.21.2"
  }
}
